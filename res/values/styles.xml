<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- 1. Extends surface into the cutout area in landscape and portrait -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- 2. Forces window surface to span under system status and navigation bars -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>
</resources>
